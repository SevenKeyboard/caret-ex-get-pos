<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>CaretExGetPos.DpiSmoke</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Keep previous architecture/build outputs out of SDK source/content globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts*/**;reports/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SevenKeyboard.CaretExGetPos/SevenKeyboard.CaretExGetPos.csproj" />
  </ItemGroup>
</Project>
