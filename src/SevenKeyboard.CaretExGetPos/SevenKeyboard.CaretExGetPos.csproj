<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>4.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <UiAutomationClientProjectPath Condition="'$(UiAutomationClientProjectPath)' == ''">$(MSBuildThisFileDirectory)../../../../ui-automation-client/main-cs/src/SevenKeyboard.UiAutomationClient/SevenKeyboard.UiAutomationClient.csproj</UiAutomationClientProjectPath>
    <ShellHookWindowProjectPath Condition="'$(ShellHookWindowProjectPath)' == ''">$(MSBuildThisFileDirectory)../../../../shell-hook-window/main-cs/src/SevenKeyboard.ShellHookWindow/SevenKeyboard.ShellHookWindow.csproj</ShellHookWindowProjectPath>
    <LibraryBuildTargetsPath Condition="'$(LibraryBuildTargetsPath)' == ''">$(MSBuildThisFileDirectory)../../../../library-build/main-cs/CheckLibraryVersions.targets</LibraryBuildTargetsPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(UiAutomationClientProjectPath)" MinimumVersion="1.1.0" />
    <ProjectReference Include="$(ShellHookWindowProjectPath)" MinimumVersion="3.0.0" />
    <InternalsVisibleTo Include="CaretExGetPos.Smoke" />
    <InternalsVisibleTo Include="CaretExGetPos.NativeSmoke" />
    <InternalsVisibleTo Include="CaretExGetPos.DpiSmoke" />
    <None Include="../../dll/x64/windowsaccessbridge-64.dll" Link="dll/x64/windowsaccessbridge-64.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../licenses/**/*" Link="licenses/caret-ex-get-pos/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="$(LibraryBuildTargetsPath)" />
</Project>
